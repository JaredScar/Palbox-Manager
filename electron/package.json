{
  "name": "@palbox/electron",
  "version": "0.8.2",
  "description": "Palbox — self-hosted Palworld server management panel (desktop shell)",
  "author": "Palbox contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaredScar/Palbox-Manager"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "electron-log": "^5.1.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0"
  },
  "build": {
    "appId": "com.palbox.panel",
    "productName": "Palbox",
    "copyright": "Copyright © 2025 Palbox contributors",
    "electronVersion": "29.0.0",
    "icon": "build/icon.png",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "../api/dist",
        "to": "api/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../api-bundle/node_modules",
        "to": "api/node_modules",
        "filter": ["**/*", "!.cache/**", "!*.map"]
      },
      {
        "from": "../ui/dist",
        "to": "ui/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "Palbox-Setup-${version}-windows.${ext}",
      "publisherName": "Palbox",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Palbox",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "artifactName": "Palbox-${version}-mac-arm64.${ext}",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "Palbox ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "artifactName": "Palbox-${version}-linux-${arch}.${ext}",
      "maintainer": "Palbox contributors <noreply@palbox.dev>",
      "category": "Utility",
      "synopsis": "Self-hosted Palworld server management panel"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
