# ──────────────────────────────────────────────────
#  Palbox — configuration
#  Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────

# Admin credentials (change before going live!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-random-secret

# API port (the React SPA and Electron both connect here)
PORT=4000

# ── PalServer ──────────────────────────────────────
# Full path to the PalServer directory
PALSERVER_DIR=C:\PalServer

# Path to PalServer.exe (relative to PALSERVER_DIR or absolute)
PALSERVER_EXE=C:\PalServer\Pal\Binaries\Win64\PalServer-Win64-Shipping-Cmd.exe

# PalWorldSettings.ini location
SETTINGS_INI=C:\PalServer\Pal\Saved\Config\WindowsServer\PalWorldSettings.ini

# NSSM service name for PalServer (created with: nssm install PalServer ...)
PALSERVER_SERVICE=PalServer

# PalServer log file (streamed to the console view)
PALSERVER_LOG=C:\PalServer\Pal\Saved\Logs\Pal.log

# ── RCON ───────────────────────────────────────────
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your-rcon-password

# ── Backups ────────────────────────────────────────
# Where to store .zip snapshots
BACKUP_DIR=C:\PalboxBackups

# Source directory to archive (Palworld save data)
SAVE_DIR=C:\PalServer\Pal\Saved

# Retention window in days (rolling)
BACKUP_RETENTION_DAYS=7

# Nightly backup cron expression (default: 04:00 every day)
BACKUP_CRON=0 4 * * *

# ── SteamCMD ───────────────────────────────────────
STEAMCMD_EXE=C:\steamcmd\steamcmd.exe

# ── Mods (UE4SS) ───────────────────────────────────
MODS_DIR=C:\PalServer\Pal\Binaries\Win64\Mods

# ── Discord ────────────────────────────────────────
# Optional — leave blank to disable
DISCORD_WEBHOOK=

# ── Palbox API service name (NSSM) ─────────────────
PALBOX_SERVICE=PalboxAPI
